{
  "manifest_version": 3,
  "name": "P0 — Your One Thing",
  "version": "2.0.0",
  "description": "Typography-forward new tab. One priority. Every day.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://api.unsplash.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
